'use client';
import {useEffect,useState} from 'react';import {AlertTriangle,ArrowRight,FileJson2,Plus,ShieldAlert,ShieldCheck,ShoppingBag,Trash2} from 'lucide-react';import {api,post} from '@/lib/platform';import {Button,Empty,ErrorBanner,PageTitle,Panel,Select,Spinner,Textarea,Input,Status} from '@/components/ui';
type Rule={type:string;label:string;description:string;params:string[];severity:string};type Result={verdict?:string;status?:string;details?:{checks?:Array<Record<string,unknown>>;explanation?:string;reason_codes?:string[];sandbox?:boolean};verification?:{verdict?:string;details?:{checks?:Array<Record<string,unknown>>;explanation?:string}}};
export default function Commerce(){const [rules,setRules]=useState<Rule[]>([]);const [selected,setSelected]=useState<Array<{type:string;params:Record<string,string>}>>([]);const [snapshot,setSnapshot]=useState('');const [requirement,setRequirement]=useState('Validate the supplied sandbox transaction snapshot against the selected rules.');const [result,setResult]=useState<Result|null>(null);const [error,setError]=useState<unknown>(null);const [loading,setLoading]=useState(true);const [busy,setBusy]=useState(false);
useEffect(()=>{api<{rules:Rule[]}>('assurance/ecommerce/rules').then(r=>{setRules(r.rules??[]);}).catch(setError).finally(()=>setLoading(false));},[]);
function addRule(){if(!rules.length)return;setSelected(s=>[...s,{type:rules[0].type,params:{}}]);}
function patch(i:number,key:string,value:string){setSelected(s=>s.map((x,j)=>j===i?key==='type'?{type:value,params:{}}:{...x,params:{...x.params,[key]:value}}:x));}
async function verify(){setBusy(true);setError(null);setResult(null);try{if(!snapshot.trim())throw new Error('Paste an actual sandbox transaction JSON snapshot.');const tx=JSON.parse(snapshot) as Record<string,unknown>;if(typeof tx!=='object'||!tx||Array.isArray(tx))throw new Error('Snapshot must be a JSON object.');if(!selected.length)throw new Error('Select at least one assurance rule.');const expectations=selected.map(item=>{const rule=rules.find(r=>r.type===item.type);const params:Record<string,unknown>={};for(const key of rule?.params??[]){if(!item.params[key]?.trim())throw new Error(`Missing ${key} for ${rule?.label}`);params[key]=/^(amount|quantity)$/.test(key)?Number(item.params[key]):item.params[key];}return {type:item.type,...params};});const x=await post<Result>('assurance/ecommerce/verify',{transaction:tx,expectations,requirement});setResult(x);}catch(e){setError(e);}finally{setBusy(false);}}
const final=result?.verification??result;const details=final?.details;
return <><PageTitle eyebrow="SANDBOX / COMMERCE ASSURANCE" title="Verify the transaction. Not the click." description="Apply backend rule checks to an explicitly supplied staging or sandbox snapshot. This tool does not create orders, charge payments or crawl production by itself."/><div className="notice notice-warning" style={{marginBottom:21}}><ShieldAlert size={19}/><div><strong>Sandbox evidence only.</strong><br/>A PASS here proves the submitted snapshot satisfied your rules, not that the live production store is correct. Provide a genuine export from your authorized staging environment.</div></div><div className="grid-main"><div className="stack"><Panel title="01 / Transaction evidence" subtitle="Paste real JSON from the testing environment; no fixtures or simulated transactions are prefilled."><Textarea label="Sandbox transaction snapshot · JSON" rows={13} placeholder={'{\n  "product": { "sku": "...", "price": 0, "variant": "..." },\n  "cart": { "items": [], "total": 0 }\n}'} value={snapshot} onChange={e=>setSnapshot(e.target.value)}/><div style={{height:13}}/><Textarea label="Business assurance requirement" rows={3} value={requirement} onChange={e=>setRequirement(e.target.value)}/></Panel><Panel title="02 / Rule-based assertions" subtitle="All available rules are fetched from the new backend catalog"><div className="between" style={{marginBottom:18}}><span className="muted text-xs">{rules.length} supported e-commerce rule types</span><Button variant="outline" disabled={loading} onClick={addRule}><Plus size={15}/>Add assertion</Button></div>{loading?<Spinner/>:rules.length===0?<Empty title="No rule catalog available" text="Check the backend version and connection."/>:selected.length===0?<Empty title="No assertions selected" text="Add an e-commerce rule to compare against your sandbox snapshot."/>:selected.map((s,i)=>{const rule=rules.find(r=>r.type===s.type);return <div key={i} className="list-item" style={{marginBottom:12,display:'block'}}><div className="between" style={{marginBottom:13}}><strong>Assertion {i+1}</strong><Button variant="ghost" onClick={()=>setSelected(x=>x.filter((_,j)=>j!==i))}><Trash2 size={14}/></Button></div><Select label="Verification rule" value={s.type} onChange={e=>patch(i,'type',e.target.value)}>{rules.map(r=><option key={r.type} value={r.type}>{r.label}</option>)}</Select><p className="field-help">{rule?.description}</p>{rule?.params.map(k=><div key={k} style={{marginTop:11}}><Input label={k} value={s.params[k]??''} onChange={e=>patch(i,k,e.target.value)} placeholder={`Expected ${k}`}/></div>)}</div>})}<div className="form-actions"><Button onClick={()=>void verify()} disabled={busy||loading}><ShieldCheck size={16}/>{busy?'Verifying…':'Verify sandbox snapshot'}<ArrowRight size={15}/></Button></div><ErrorBanner error={error}/></Panel></div><div className="stack"><Panel title="Assurance verdict" subtitle="Server result, never an inferred UI success">{!result?<Empty title="No verification requested" text="Choose rules and submit an actual sandbox transaction snapshot to see the verdict."/>:<><div className="between"><span className="muted-label">VERIFICATION OUTCOME</span><Status value={final?.verdict}/></div><h3 style={{fontSize:23,margin:'17px 0 10px'}}>{final?.verdict??'UNVERIFIED'}</h3><p className="muted text-xs" style={{lineHeight:1.8}}>{details?.explanation??'See check details below.'}</p>{details?.reason_codes?.length?<div className="chip" style={{marginBottom:15}}>{details.reason_codes.join(', ')}</div>:null}{details?.checks?.map((check,i)=><div className="key-value" key={i}><span>{String(check.key??check.id??`Check ${i+1}`)}</span><strong>{String(check.status??check.passed??'unknown')}</strong></div>)}</>}</Panel><Panel title="Available verification rules"><div className="outline-list">{rules.map(r=><div className="list-item" key={r.type}><ShoppingBag size={18}/><div><strong>{r.label}</strong><p>{r.description}</p></div></div>)}</div></Panel></div></div></>;
}
