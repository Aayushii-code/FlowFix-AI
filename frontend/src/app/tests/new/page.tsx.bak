'use client';
import { useEffect, useState } from 'react';
import { useRouter } from 'next/navigation';
import { AlertTriangle, ArrowRight, Check, ChevronDown, Code2, FileCheck2, Plus, Rocket, ShieldAlert, Sparkles, Trash2, WandSparkles } from 'lucide-react';
import { api, Check, CompileResult, Execution, friendlyError, post } from '@/lib/platform';
import { Button, ErrorBanner, Input, PageTitle, Panel, Select, Textarea } from '@/components/ui';
const blankCheck=():Check=>({key:'',source:'page',operator:'contains',expected:'',severity:'medium',required:true});
const fallbackOperators=['equals','not_equals','contains','not_contains','starts_with','ends_with','regex','in','not_in','gt','gte','lt','lte','exists','not_exists','min_count','max_count'];
const fallbackSources=['page','api','database','sandbox','agent_report','observation'];
export default function CreateTest() {
  const router=useRouter();
  const [url,setUrl]=useState('');const [requirement,setRequirement]=useState('');const [name,setName]=useState('');const [goal,setGoal]=useState('');const [risk,setRisk]=useState('medium');const [checks,setChecks]=useState<Check[]>([blankCheck()]);const [operators,setOperators]=useState(fallbackOperators);const [sources,setSources]=useState(fallbackSources);
  const [busy,setBusy]=useState<'compile'|'save'|'run'|null>(null);const [error,setError]=useState<unknown>(null);const [message,setMessage]=useState('');const [draft,setDraft]=useState<CompileResult|null>(null);
  useEffect(()=>{ api<{operators:string[];sources:Array<{source:string}>}>('check-types').then(x=>{if(x.operators?.length)setOperators(x.operators);if(x.sources?.length)setSources(x.sources.map(z=>z.source));}).catch(()=>{});},[]);
  function patch(i:number, field:keyof Check, value:unknown){setChecks(prev=>prev.map((c,j)=>j===i?({...c,[field]:value}):c));}
  async function compile(){if(!requirement.trim())return setError('Write a business requirement first.');setBusy('compile');setError(null);setMessage('');try{const x=await post<CompileResult>('contracts/compile',{requirement,url:url||undefined});setDraft(x);setName(String(x.draft.name??''));setGoal(String(x.draft.goal??''));setUrl(String(x.draft.url??url));setRisk(String(x.draft.risk_level??'medium'));setChecks(x.draft.checks?.length?x.draft.checks:[blankCheck()]);setMessage('Draft generated. Please review the proposed checks; unsupported requirements are not invented.');}catch(e){setError(e);}finally{setBusy(null);}}
  function payload(){if(!url.startsWith('https://'))throw new Error('Use an authorized HTTPS website URL.');if(requirement.trim().length<10)throw new Error('Requirement must be at least 10 characters.');const valid=checks.filter(c=>c.key.trim()&&c.operator);if(!valid.length)throw new Error('Add at least one valid measurable check.');if(valid.some(c=>!['exists','not_exists'].includes(c.operator) && (c.expected===null||c.expected===undefined||String(c.expected).trim()==='')))throw new Error('Specify expected values for all checks.');return {url,requirement:requirement.trim(),goal:goal.trim()||requirement.trim(),checks:valid,expected_outcome:{type:'flowfix_explicit_checks_v1',checks:valid},browser_profile:'lite',capture_config:{screenshots:true,html:true}};}
  async function run(){setBusy('run');setError(null);try{const data=payload();const out=await post<Execution>('executions',data);router.push(`/runs/${out.execution_id}`);}catch(e){setError(e);setBusy(null);}}
  async function save(){setBusy('save');setError(null);try{const p=payload();await post('contracts',{name:name.trim()||requirement.slice(0,75),requirement:p.requirement,url:p.url,goal:p.goal,checks:p.checks,risk_level:risk,source:draft?'nl_compiler':'manual',expected_outcome:p.expected_outcome});router.push('/contracts');}catch(e){setError(e);setBusy(null);}}
  return <><PageTitle eyebrow="CREATE / VERIFY" title="Turn a requirement into proof." description="Describe the behavior you expect. Use the deterministic requirement compiler or design precise checks manually. Review everything before execution."/>
    <div className="grid-main"><div className="stack"><Panel title="01 / Describe the journey" subtitle="Only test sites you own or have explicit permission to automate."><ErrorBanner error={error}/><div className="stack" style={{gap:15}}><Input label="Authorized target URL" placeholder="https://your-site.com" value={url} onChange={e=>setUrl(e.target.value)}/><Textarea label="Business requirement" rows={5} placeholder={'For example: On https://example.com the page headline must contain "Example Domain".'} value={requirement} onChange={e=>setRequirement(e.target.value)}/><div className="form-actions" style={{margin:0}}><Button onClick={()=>void compile()} disabled={!!busy}><WandSparkles size={17}/>{busy==='compile'?'Compiling…':'Generate checks from requirement'}</Button><span className="muted text-xs">Deterministic compiler · review required</span></div>{message&&<div className="notice"><Check size={17}/>{message}</div>}{draft&&<div className="notice notice-warning"><AlertTriangle size={17}/><div><strong>Compiler confidence: {draft.confidence??'unknown'}</strong><br/>{draft.ambiguities?.length?draft.ambiguities.map((a,i)=><span key={i}>{a.message}{i<draft.ambiguities!.length-1?' · ':''}</span>):'No ambiguities reported. Human review is still required.'}</div></div>}</div></Panel>
      <Panel title="02 / Define verification checks" subtitle="Checks are evaluated against specified evidence sources, independently of agent completion."><div className="between" style={{marginBottom:15}}><span className="muted text-xs">Missing evidence → INCONCLUSIVE, never an invented PASS.</span><Button variant="outline" onClick={()=>setChecks(x=>[...x,blankCheck()])}><Plus size={14}/> Add check</Button></div>{checks.map((c,i)=><div className="check-row" key={i}><Input label="Field / key" value={c.key} placeholder="headline" onChange={e=>patch(i,'key',e.target.value)}/><Select label="Source" value={c.source??'page'} onChange={e=>patch(i,'source',e.target.value)}>{sources.map(s=><option key={s} value={s}>{s}</option>)}</Select><Select label="Operator" value={c.operator} onChange={e=>patch(i,'operator',e.target.value)}>{operators.map(x=><option key={x} value={x}>{x}</option>)}</Select><Input label="Expected" value={String(c.expected??'')} placeholder="Expected value" onChange={e=>patch(i,'expected',e.target.value)}/><button type="button" className="btn btn-outline btn-mini" aria-label={`Remove check ${i+1}`} disabled={checks.length===1} onClick={()=>setChecks(x=>x.filter((_,j)=>i!==j))}><Trash2 size={14}/></button></div>)}<p className="field-help">Page checks re-fetch independent page evidence. Agent report is context only and cannot independently prove PASS.</p></Panel>
      <Panel title="03 / Finalize & launch" subtitle="Execute a one-time journey or save a reusable, versioned contract."><div className="form-grid"><Input label="Contract name (optional for runs)" placeholder="Homepage headline assurance" value={name} onChange={e=>setName(e.target.value)}/><Select label="Business risk" value={risk} onChange={e=>setRisk(e.target.value)}>{['low','medium','high','critical'].map(x=><option key={x} value={x}>{x}</option>)}</Select></div><div style={{height:15}}/><Textarea label="Browser agent goal" rows={4} placeholder="Specify the actions TinyFish should perform (optional; requirement used if empty)." value={goal} onChange={e=>setGoal(e.target.value)}/><div className="form-actions"><Button onClick={()=>void run()} disabled={!!busy}><Rocket size={16}/>{busy==='run'?'Starting…':'Run real browser test'}<ArrowRight size={15}/></Button><Button variant="outline" onClick={()=>void save()} disabled={!!busy}><FileCheck2 size={16}/>{busy==='save'?'Saving…':'Save as contract'}</Button></div></Panel></div>
      <div className="stack"><div className="callout-card"><Sparkles size={27}/><h3>Why this is different</h3><p>Automation agents perform the journey, but FlowFix runs separately sourced checks. Browser COMPLETED does not equal a verification PASS.</p></div><Panel title="Before you run" subtitle="Safe testing practices"><div className="outline-list"><div className="list-item"><ShieldAlert size={18}/><div><strong>Authorized targets only</strong><p>Never use FlowFix on websites you cannot test.</p></div></div><div className="list-item"><Code2 size={18}/><div><strong>Readable conditions</strong><p>Each check needs a source, operator and expected value.</p></div></div><div className="list-item"><FileCheck2 size={18}/><div><strong>Results are evidence-led</strong><p>Missing independent proof is reported as inconclusive.</p></div></div></div></Panel><div className="notice notice-warning"><AlertTriangle size={16}/>Browser automation can consume TinyFish credits. Do not submit duplicate jobs while another is running.</div></div></div>
  </>;
}
