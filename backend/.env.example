# ─── FlowFix AI backend environment ──────────────────────────────────────────
# Copy this file to .env and fill in real values. .env is gitignored.

# ─── TinyFish (REQUIRED for real browser runs) ───────────────────────────────
# Get a key at https://agent.tinyfish.ai/api-keys
# Without it, the API still starts, but executions fail fast with
# TINYFISH_NOT_CONFIGURED instead of calling TinyFish.
TINYFISH_API_KEY=

# Override only for tests/mocks. Production must use the canonical endpoint.
TINYFISH_BASE_URL=https://agent.tinyfish.ai

# ─── Execution control ───────────────────────────────────────────────────────
# HTTP port for this API
PORT=3000

# Hard watchdog for one execution (ms). This is OUR timeout, independent of
# agent_config.max_duration_seconds which is TinyFish's own stop condition.
EXECUTION_TIMEOUT_MS=300000

# Max simultaneously running executions (TinyFish enforces a pending-run cap).
MAX_CONCURRENT_EXECUTIONS=3

# ─── Verification engine ────────────────────────────────────────────────────────
# Base URL of the external independent verification engine (Meenu's component).
# When set, it takes precedence: the backend forwards observations + evidence
# and never evaluates checks itself.
VERIFICATION_ENGINE_URL=
VERIFICATION_TIMEOUT_MS=20000

# FlowFix's OWN independent verifier, used only when VERIFICATION_ENGINE_URL is
# empty AND the requirement carries `checks`. It re-fetches page evidence and
# evaluates the checks against it (PASS / FAIL / INCONCLUSIVE).
# Set to "off" to restore engine-or-UNAVAILABLE behaviour.
LOCAL_VERIFICATION=on

# ─── Persistence ──────────────────────────────────────────────────────────────
# SQLite file holding contracts, run history and the audit log.
# Relative to the backend directory; use :memory: only for throwaway testing.
DATABASE_PATH=data/flowfix.db

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated allowlist for browser clients. Unset = dev-permissive (*).
# MUST be set before this port is reachable outside localhost.
CORS_ORIGINS=
